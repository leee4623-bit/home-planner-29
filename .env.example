# 재무플래너 환경변수 예시 — 실제 값은 이 파일에 쓰지 말고 Render → 서비스 → Environment 화면에 직접 입력하세요.
# 내 PC에서 쓸 때는 이 파일을 복사해 .env 로 만들지 말고(자동으로 읽지 않음), 실행 창에서 환경변수로 지정하세요.

# 공용 Postgres(Neon) 연결 문자열. 비워 두면 내 PC 파일 DB(data/planner.db) 사용
DATABASE_URL=postgres://사용자:비밀번호@호스트/DB이름?sslmode=require

# 세션 비밀키(32자 이상 무작위). 운영(NODE_ENV=production)에서는 필수
SESSION_SECRET=여기에-32자-이상-무작위-문자열

NODE_ENV=production
PORT=8080

# 1=시연 모드(가상 계정·공용 비밀번호), 0=실제 운영(시연 계정 로그인 차단)
FP_DEMO=1
FP_DEMO_PASSWORD=시연용-비밀번호

# 관리자 API 토큰(선택). 없으면 /api/admin 비활성
FP_ADMIN_TOKEN=

# 금융감독원 「금융상품 한눈에」 오픈API 인증키(선택)
FSS_API_KEY=

# Web Push 연락처(선택)
FP_VAPID_SUBJECT=mailto:you@example.com
